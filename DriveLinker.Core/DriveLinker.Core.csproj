<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- DriveLinker only ships on Windows (it drives `net use`), so the core library targets Windows only. -->
		<TargetFramework>$(DriveLinkerTargetFramework)</TargetFramework>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<!-- The app resolves this library's .pri file with its own RID (e.g. win-x64) appended; keep a single,
		     RID-independent output folder so `dotnet publish -r win-x64` of the app can find it. -->
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="CommunityToolkit.Maui" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<!--
			Only the SQLCipher flavour of sqlite-net is referenced. Referencing sqlite-net-pcl as well
			ships two copies of SQLite-net.dll / two native bundles, and whichever wins decides whether
			the database password is honoured at all.
		-->
		<PackageReference Include="sqlite-net-sqlcipher" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
	</ItemGroup>

</Project>
